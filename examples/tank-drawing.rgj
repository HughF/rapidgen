# rapidgen example: the band comes from a DXF of the unrolled surface.
# tank02.dxf is 1884.96 mm wide (2 x pi x 300) and 800 mm tall, starting
# 100 mm above the table, on layer SPRAY. For an S4C, so the name fits 8.3.

name        = TANK02
controller  = s4c
robot       = irb2400_16
drawing     = tank02.dxf
layer       = SPRAY

radius      = 300
part_height = 1000
axis        = 1450 0 300
rpm         = 30

pattern     = spot
spot_diameter = 12
step_over   = 6
standoff    = 150
coats       = 2
cycles      = 8
dwell       = 20
thickness_per_pass = 25
target_thickness   = 350

tool        = tSprayGun
tool_define = yes
tool_tcp    = 0 -120 180
tool_rot    = 0.866025 0.5 0 0
tool_mass   = 2.5
tool_cog    = 0 -40 80
