# rapidgen example: one band written directly, no drawing.
# See `rapidgen --template` for every setting and what it means.

name        = TANK01
controller  = s4c_plus
robot       = irb2400_16
band        = 100 900

radius      = 300
part_height = 1000
axis        = 1450 0 300
azimuth     = 0
rpm         = 30

pattern     = spot
spot_diameter = 12
step_over   = 6
standoff    = 150
coats       = 2
cycles      = 8
dwell       = 20
thickness_per_pass = 25
target_thickness   = 350
start       = top

tool        = tSprayGun
tool_define = no
tool_tcp    = 0 -120 180
tool_rot    = 0.866025 0.5 0 0

home         = 0 0 0 0 30 0
ready_prompt = yes
